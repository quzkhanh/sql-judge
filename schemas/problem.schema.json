{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqljudge.local/schemas/problem-v1.json",
  "title": "SQL Judge Problem v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "difficulty", "topics", "statement", "dialect", "reference", "output", "limits", "tests"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 80},
    "title": {"type": "string", "minLength": 3, "maxLength": 140},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "topics": {"type": "array", "minItems": 1, "maxItems": 15, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}},
    "statement": {"type": "string", "minLength": 20, "maxLength": 12000},
    "dialect": {"enum": ["postgresql", "sqlserver"]},
    "reference": {"const": "reference.sql"},
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["row_order", "strict_column_names", "strict_column_types", "columns"],
      "properties": {
        "row_order": {"enum": ["ordered", "unordered"]},
        "strict_column_names": {"type": "boolean"},
        "strict_column_types": {"type": "boolean"},
        "columns": {"type": "array", "minItems": 1, "maxItems": 128,
          "items": {"type": "object", "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"},
              "type": {"enum": ["integer", "bigint", "numeric", "float", "text", "boolean", "date", "timestamp", "timestamptz", "uuid", "json", "binary"]}
            }
          }
        }
      }
    },
    "limits": {"type": "object", "additionalProperties": false,
      "required": ["statement_timeout_ms", "max_rows", "max_bytes"],
      "properties": {
        "statement_timeout_ms": {"type": "integer", "minimum": 100, "maximum": 10000},
        "max_rows": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_bytes": {"type": "integer", "minimum": 1024, "maximum": 16777216}
      }
    },
    "tests": {"type": "array", "minItems": 3, "maxItems": 50,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["id", "file", "hidden"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
          "file": {"type": "string", "pattern": "^tests/[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.sql$"},
          "hidden": {"type": "boolean"}
        }
      }
    }
  }
}
