{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqljudge.local/schemas/pack-v1.json",
  "title": "SQL Judge Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "id", "version", "title", "dialect", "schema", "problems"],
  "properties": {
    "spec_version": {"const": "sqljudge.pack/v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 80},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 140},
    "dialect": {"enum": ["postgresql", "sqlserver"]},
    "min_engine_version": {"type": "string", "minLength": 1, "maxLength": 30},
    "schema": {
      "type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^schema/[a-zA-Z0-9][a-zA-Z0-9_-]*\\.sql$"}
    },
    "problems": {
      "type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^problems/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/problem\\.json$"}
    }
  }
}
