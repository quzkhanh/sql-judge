{
  "id": "above-average",
  "title": "Employees Earning Above Their Department Average",
  "difficulty": "medium",
  "topics": ["correlated-subquery", "aggregation"],
  "statement": "Return one row per employee whose salary is STRICTLY greater than the average of non-NULL salaries in their own department. Output employee_id (integer) and employee_name (text). Do not rely on row ordering; there may be multiple departments, tied salaries, NULL salaries, and departments with no employees.",
  "dialect": "postgresql",
  "reference": "reference.sql",
  "output": {
    "row_order": "unordered",
    "strict_column_names": true,
    "strict_column_types": true,
    "columns": [
      { "name": "employee_id", "type": "integer" },
      { "name": "employee_name", "type": "text" }
    ]
  },
  "limits": {
    "statement_timeout_ms": 2000,
    "max_rows": 10000,
    "max_bytes": 16777216
  },
  "catalog": {
    "schema": [
      {
        "name": "departments",
        "columns": [
          { "name": "id", "type": "integer" },
          { "name": "name", "type": "text" }
        ]
      },
      {
        "name": "employees",
        "columns": [
          { "name": "id", "type": "integer" },
          { "name": "name", "type": "text" },
          { "name": "department_id", "type": "integer" },
          { "name": "salary", "type": "numeric", "nullable": true }
        ]
      }
    ],
    "sample_rows": [
      { "employee_id": 1, "employee_name": "Alice" },
      { "employee_id": 4, "employee_name": "David" }
    ],
    "starter_sql": "SELECT e.id AS employee_id, e.name AS employee_name FROM employees AS e WHERE e.salary > (SELECT AVG(peer.salary) FROM employees AS peer WHERE peer.department_id = e.department_id);"
  },
  "tests": [
    { "id": "basic", "file": "tests/basic.sql", "hidden": false },
    { "id": "edge", "file": "tests/edge.sql", "hidden": true },
    { "id": "empty", "file": "tests/empty.sql", "hidden": true }
  ]
}
