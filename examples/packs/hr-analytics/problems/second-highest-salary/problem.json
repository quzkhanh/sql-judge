{
  "id": "second-highest-salary",
  "title": "Second highest salary per department",
  "difficulty": "medium",
  "topics": [
    "window-functions",
    "ranking"
  ],
  "statement": "For every department, return the **second highest distinct salary** paid to its employees. Departments with fewer than two distinct salaries must still appear, with `NULL` as the salary. Ignore `NULL` salaries when ranking. Return exactly one row per department with `department_name` and `second_salary`. Any row order is accepted.",
  "dialect": "postgresql",
  "reference": "reference.sql",
  "output": {
    "row_order": "unordered",
    "strict_column_names": true,
    "strict_column_types": true,
    "columns": [
      {
        "name": "department_name",
        "type": "text"
      },
      {
        "name": "second_salary",
        "type": "numeric"
      }
    ]
  },
  "limits": {
    "statement_timeout_ms": 2000,
    "max_rows": 10000,
    "max_bytes": 16777216
  },
  "catalog": {
    "schema": [
      {
        "name": "departments",
        "columns": [
          {
            "name": "id",
            "type": "integer"
          },
          {
            "name": "name",
            "type": "text"
          }
        ]
      },
      {
        "name": "employees",
        "columns": [
          {
            "name": "id",
            "type": "integer"
          },
          {
            "name": "name",
            "type": "text"
          },
          {
            "name": "email",
            "type": "text"
          },
          {
            "name": "department_id",
            "type": "integer"
          },
          {
            "name": "manager_id",
            "type": "integer",
            "nullable": true
          },
          {
            "name": "salary",
            "type": "numeric",
            "nullable": true
          },
          {
            "name": "hired_on",
            "type": "date"
          }
        ]
      }
    ],
    "sample_rows": [
      {
        "department_name": "Engineering",
        "second_salary": 120000
      },
      {
        "department_name": "Finance",
        "second_salary": null
      },
      {
        "department_name": "Design",
        "second_salary": 72000
      }
    ],
    "starter_sql": "SELECT d.name AS department_name,\n       ranked.salary AS second_salary\nFROM departments d\nLEFT JOIN (\n  SELECT department_id,\n         salary,\n         DENSE_RANK() OVER (\n           PARTITION BY department_id\n           ORDER BY salary DESC\n         ) AS rnk\n  FROM employees\n) ranked\n  ON ranked.department_id = d.id\n AND ranked.rnk = 2;",
    "sample_tables": [
      {
        "name": "employees",
        "rows": [
          {
            "id": 1,
            "name": "Linh",
            "department_id": 1,
            "salary": 135000
          },
          {
            "id": 2,
            "name": "Minh",
            "department_id": 1,
            "salary": 120000
          },
          {
            "id": 3,
            "name": "Hoa",
            "department_id": 1,
            "salary": 120000
          },
          {
            "id": 4,
            "name": "Quan",
            "department_id": 2,
            "salary": 98000
          },
          {
            "id": 5,
            "name": "Trang",
            "department_id": 3,
            "salary": 87000
          },
          {
            "id": 6,
            "name": "Bao",
            "department_id": 3,
            "salary": 72000
          }
        ]
      },
      {
        "name": "departments",
        "rows": [
          {
            "id": 1,
