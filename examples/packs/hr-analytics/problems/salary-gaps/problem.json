{
  "id": "salary-gaps",
  "title": "Salary gap to the previous hire",
  "difficulty": "medium",
  "topics": [
    "window-functions"
  ],
  "statement": "Within each department, order employees by `hired_on` and then by `id` to break ties. For every employee with a non-`NULL` salary, return `employee_id`, `employee_name`, and `salary_gap`: their salary minus the salary of the **previous** employee in that order. Employees with a `NULL` salary are left out entirely and are skipped when finding the previous employee. The first employee of each department has a `NULL` gap. Any row order is accepted.",
  "dialect": "postgresql",
  "reference": "reference.sql",
  "output": {
    "row_order": "unordered",
    "strict_column_names": true,
    "strict_column_types": true,
    "columns": [
      {
        "name": "employee_id",
        "type": "integer"
      },
      {
        "name": "employee_name",
        "type": "text"
      },
      {
        "name": "salary_gap",
        "type": "numeric"
      }
    ]
  },
  "limits": {
    "statement_timeout_ms": 2000,
    "max_rows": 10000,
    "max_bytes": 16777216
  },
  "catalog": {
    "schema": [
      {
        "name": "departments",
        "columns": [
          {
            "name": "id",
            "type": "integer"
          },
          {
            "name": "name",
            "type": "text"
          }
        ]
      },
      {
        "name": "employees",
        "columns": [
          {
            "name": "id",
            "type": "integer"
          },
          {
            "name": "name",
            "type": "text"
          },
          {
            "name": "email",
            "type": "text"
          },
          {
            "name": "department_id",
            "type": "integer"
          },
          {
            "name": "manager_id",
            "type": "integer",
            "nullable": true
          },
          {
            "name": "salary",
            "type": "numeric",
            "nullable": true
          },
          {
            "name": "hired_on",
            "type": "date"
          }
        ]
      }
    ],
    "sample_rows": [
      {
        "employee_id": 1,
        "employee_name": "Linh",
        "salary_gap": null
      },
