{
  "id": "duplicate-emails",
  "title": "Duplicate employee emails",
  "difficulty": "easy",
  "topics": [
    "aggregation"
  ],
  "statement": "Some employees were created twice with the same email address. Compare emails **case-insensitively** and return one row per address used by two or more employees: the lower-cased `email` and the number of employees using it as `employee_count`. Addresses used once must not appear. Any row order is accepted.",
  "dialect": "postgresql",
  "reference": "reference.sql",
  "output": {
    "row_order": "unordered",
    "strict_column_names": true,
    "strict_column_types": true,
    "columns": [
      {
        "name": "email",
        "type": "text"
      },
      {
        "name": "employee_count",
        "type": "bigint"
      }
    ]
  },
  "limits": {
    "statement_timeout_ms": 2000,
    "max_rows": 10000,
    "max_bytes": 16777216
  },
  "catalog": {
    "schema": [
      {
        "name": "departments",
        "columns": [
          {
            "name": "id",
            "type": "integer"
          },
          {
            "name": "name",
            "type": "text"
          }
        ]
      },
      {
        "name": "employees",
        "columns": [
          {
            "name": "id",
            "type": "integer"
          },
          {
            "name": "name",
            "type": "text"
          },
          {
            "name": "email",
            "type": "text"
          },
          {
            "name": "department_id",
            "type": "integer"
          },
          {
            "name": "manager_id",
            "type": "integer",
            "nullable": true
          },
          {
            "name": "salary",
            "type": "numeric",
            "nullable": true
          },
          {
            "name": "hired_on",
            "type": "date"
          }
        ]
      }
    ],
    "sample_rows": [
      {
        "email": "linh@example.com",
        "employee_count": 2
      }
    ],
    "starter_sql": "SELECT e.email,\n       e.name\nFROM employees AS e;",
    "sample_tables": [
      {
        "name": "employees",
        "rows": [
          {
            "id": 1,
            "name": "Linh",
            "email": "linh@example.com"
          },
          {
            "id": 2,
            "name": "Minh",
            "email": "minh@example.com"
          },
          {
            "id": 3,
            "name": "Linh Tran",
            "email": "linh@example.com"
          },
          {
            "id": 4,
            "name": "Hoa",
            "email": "hoa@example.com"
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "id": "basic",
      "file": "tests/basic.sql",
      "hidden": false
    },
    {
      "id": "case-variants",
      "file": "tests/case-variants.sql",
      "hidden": true
    },
    {
      "id": "all-unique",
      "file": "tests/all-unique.sql",
      "hidden": true
    },
    {
      "id": "no-employees",
      "file": "tests/no-employees.sql",
      "hidden": true
    }
  ]
}
