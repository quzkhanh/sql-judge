{
  "id": "headcount-by-year",
  "title": "Department headcount by year",
  "difficulty": "easy",
  "topics": [
    "aggregation",
    "dates"
  ],
  "statement": "Count how many employees each department hired in each calendar year, based on `hired_on`. Return one row per department and year with at least one hire: `department_name`, `hire_year` (an integer such as `2023`), and `hires`. Departments or years without hires must not appear. Any row order is accepted.",
  "dialect": "postgresql",
  "reference": "reference.sql",
  "output": {
    "row_order": "unordered",
    "strict_column_names": true,
    "strict_column_types": true,
    "columns": [
      {
        "name": "department_name",
        "type": "text"
      },
      {
        "name": "hire_year",
        "type": "integer"
      },
      {
        "name": "hires",
        "type": "bigint"
      }
    ]
  },
  "limits": {
    "statement_timeout_ms": 2000,
    "max_rows": 10000,
    "max_bytes": 16777216
  },
  "catalog": {
    "schema": [
      {
        "name": "departments",
        "columns": [
          {
            "name": "id",
            "type": "integer"
          },
          {
            "name": "name",
            "type": "text"
          }
        ]
      },
      {
        "name": "employees",
        "columns": [
          {
            "name": "id",
            "type": "integer"
          },
          {
            "name": "name",
            "type": "text"
          },
          {
            "name": "email",
            "type": "text"
          },
          {
            "name": "department_id",
            "type": "integer"
          },
          {
            "name": "manager_id",
            "type": "integer",
            "nullable": true
          },
          {
            "name": "salary",
            "type": "numeric",
            "nullable": true
          },
          {
            "name": "hired_on",
            "type": "date"
          }
        ]
      }
    ],
    "sample_rows": [
      {
        "department_name": "Finance",
        "hire_year": 2023,
        "hires": 1
      },
      {
        "department_name": "Engineering",
        "hire_year": 2023,
        "hires": 1
      },
      {
        "department_name": "Engineering",
        "hire_year": 2022,
        "hires": 2
      }
    ],
    "starter_sql": "SELECT d.name AS department_name,\n       e.hired_on\nFROM employees AS e\nJOIN departments AS d\n  ON d.id = e.department_id;",
    "sample_tables": [
      {
        "name": "employees",
        "rows": [
          {
            "id": 1,
            "name": "Linh",
            "department_id": 1,
            "hired_on": "2022-02-14"
          },
          {
            "id": 2,
            "name": "Minh",
            "department_id": 1,
            "hired_on": "2022-09-01"
          },
          {
            "id": 3,
            "name": "Hoa",
            "department_id": 1,
            "hired_on": "2023-01-09"
          },
          {
            "id": 4,
            "name": "Quan",
            "department_id": 2,
            "hired_on": "2023-05-22"
          }
        ]
      },
      {
        "name": "departments",
        "rows": [
          {
            "id": 1,
            "name": "Engineering"
          },
          {
            "id": 2,
            "name": "Finance"
          }
        ]
      }
    ]
  },
  "tests": [
