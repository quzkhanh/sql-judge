{
  "id": "reporting-chain",
  "title": "Managers and their reporting chain",
  "difficulty": "hard",
  "topics": [
    "recursive-cte"
  ],
  "statement": "`employees.manager_id` forms a reporting hierarchy without cycles. Return one row for every pair of a manager and an employee who reports to them **directly or indirectly**: `manager_id`, `employee_id`, and `depth`, where `depth` is `1` for a direct report, `2` for a report of a report, and so on. Employees without a manager appear only as managers. Any row order is accepted.",
  "dialect": "postgresql",
  "reference": "reference.sql",
  "output": {
    "row_order": "unordered",
    "strict_column_names": true,
    "strict_column_types": true,
    "columns": [
      {
        "name": "manager_id",
        "type": "integer"
      },
      {
        "name": "employee_id",
        "type": "integer"
      },
      {
        "name": "depth",
        "type": "integer"
      }
    ]
  },
  "limits": {
    "statement_timeout_ms": 2000,
    "max_rows": 10000,
    "max_bytes": 16777216
  },
  "catalog": {
    "schema": [
      {
        "name": "departments",
        "columns": [
          {
            "name": "id",
            "type": "integer"
          },
          {
            "name": "name",
            "type": "text"
          }
        ]
      },
      {
        "name": "employees",
        "columns": [
          {
            "name": "id",
            "type": "integer"
          },
          {
            "name": "name",
            "type": "text"
          },
          {
            "name": "email",
            "type": "text"
          },
          {
            "name": "department_id",
            "type": "integer"
          },
          {
            "name": "manager_id",
            "type": "integer",
            "nullable": true
          },
          {
            "name": "salary",
            "type": "numeric",
            "nullable": true
          },
          {
            "name": "hired_on",
            "type": "date"
          }
        ]
      }
    ],
    "sample_rows": [
      {
        "manager_id": 1,
        "employee_id": 2,
        "depth": 1
      },
      {
        "manager_id": 1,
        "employee_id": 3,
        "depth": 1
      },
      {
        "manager_id": 2,
        "employee_id": 4,
        "depth": 1
      },
      {
        "manager_id": 4,
        "employee_id": 5,
        "depth": 1
      },
      {
        "manager_id": 1,
        "employee_id": 4,
        "depth": 2
      },
      {
        "manager_id": 2,
        "employee_id": 5,
        "depth": 2
      },
      {
        "manager_id": 1,
        "employee_id": 5,
        "depth": 3
      }
    ],
    "starter_sql": "SELECT e.manager_id,\n       e.id AS employee_id,\n       1 AS depth\nFROM employees AS e\nWHERE e.manager_id IS NOT NULL;",
    "sample_tables": [
      {
        "name": "employees",
        "rows": [
          {
