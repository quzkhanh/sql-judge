{
  "id": "departments-without-employees",
  "title": "Departments without employees",
  "difficulty": "easy",
  "topics": [
    "joins"
  ],
  "statement": "Return every department that has **no** employees at all. Output one row per such department with `department_id` and `department_name`. A department with at least one employee, even one with a `NULL` salary, is staffed and must not appear. Any row order is accepted.",
  "dialect": "postgresql",
  "reference": "reference.sql",
  "output": {
    "row_order": "unordered",
    "strict_column_names": true,
    "strict_column_types": true,
    "columns": [
      {
        "name": "department_id",
        "type": "integer"
      },
      {
        "name": "department_name",
        "type": "text"
      }
    ]
  },
  "limits": {
    "statement_timeout_ms": 2000,
    "max_rows": 10000,
    "max_bytes": 16777216
  },
  "catalog": {
    "schema": [
      {
        "name": "departments",
        "columns": [
          {
            "name": "id",
            "type": "integer"
          },
          {
            "name": "name",
            "type": "text"
          }
        ]
      },
      {
        "name": "employees",
        "columns": [
          {
            "name": "id",
            "type": "integer"
          },
          {
            "name": "name",
            "type": "text"
          },
          {
            "name": "email",
            "type": "text"
          },
          {
            "name": "department_id",
            "type": "integer"
          },
          {
            "name": "manager_id",
            "type": "integer",
            "nullable": true
          },
          {
            "name": "salary",
            "type": "numeric",
            "nullable": true
          },
          {
            "name": "hired_on",
            "type": "date"
          }
        ]
      }
    ],
    "sample_rows": [
      {
        "department_id": 2,
        "department_name": "Finance"
      },
      {
        "department_id": 4,
        "department_name": "Legal"
      }
    ],
    "starter_sql": "SELECT d.id AS department_id,\n       d.name AS department_name,\n       e.id AS employee_id\nFROM departments AS d\nLEFT JOIN employees AS e\n  ON e.department_id = d.id;",
    "sample_tables": [
      {
        "name": "employees",
        "rows": [
          {
            "id": 1,
            "name": "Linh",
            "department_id": 1
          },
          {
