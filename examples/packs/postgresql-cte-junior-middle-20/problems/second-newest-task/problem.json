{
  "id": "second-newest-task",
  "title": "CTE 10 — Second Newest Task",
  "difficulty": "medium",
  "topics": ["cte", "row-number", "pagination"],
  "statement": "Cho mỗi project có ít nhất 2 task, lấy task đứng THỨ HAI theo created_at mới nhất, nếu trùng ngày task id lớn hơn đứng trước. Project dưới 2 task không xuất hiện. Mỗi dòng = một project. Trả về project_id, task_id, created_at. Bắt buộc luyện bằng WITH ... AS (recursive ở bài yêu cầu đệ quy); judge chấm theo output.",
  "dialect": "postgresql",
  "reference": "reference.sql",
  "output": {
    "row_order": "unordered",
    "strict_column_names": true,
    "strict_column_types": true,
    "columns": [
      {
        "name": "project_id",
        "type": "integer"
      },
      {
        "name": "task_id",
        "type": "integer"
      },
      {
        "name": "created_at",
        "type": "date"
      }
    ]
  },
  "limits": {
    "statement_timeout_ms": 5000,
    "max_rows": 10000,
    "max_bytes": 16777216
  },
