{
  "id": "03-project-status-summary",
  "title": "CTE 03 — Project Status Dashboard",
  "difficulty": "easy",
  "topics": ["cte", "left-join", "conditional-aggregation"],
  "statement": "Dashboard trả về TẤT CẢ project, kể cả project không có task: total_tasks (tổng task), available_tasks (status AVAILABLE), completed_tasks (status DONE). Tất cả số đếm phải là 0 nếu không có bản ghi. Mỗi dòng = một project. Trả về project_id, total_tasks, available_tasks, completed_tasks. Bắt buộc luyện bằng WITH ... AS (recursive ở bài yêu cầu đệ quy); judge chấm theo output.",
  "dialect": "postgresql",
  "reference": "reference.sql",
  "output": {
    "row_order": "unordered",
    "strict_column_names": true,
    "strict_column_types": true,
    "columns": [
      {
        "name": "project_id",
        "type": "integer"
      },
      {
        "name": "total_tasks",
        "type": "bigint"
      },
      {
        "name": "available_tasks",
        "type": "bigint"
      },
      {
        "name": "completed_tasks",
        "type": "bigint"
      }
    ]
  },
  "limits": {
    "statement_timeout_ms": 5000,
    "max_rows": 10000,
    "max_bytes": 16777216
  },
